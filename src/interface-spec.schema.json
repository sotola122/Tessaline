{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://md-docs.local/tools/interface-spec/schema/interface-spec.schema.json",
  "title": "md-docs Interface Spec Source Contract",
  "type": "object",
  "required": ["apiVersion", "info", "operations"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "type": "string", "const": "interface-spec/v1" },
    "info": { "$ref": "#/$defs/info" },
    "servers": { "type": "object", "additionalProperties": true },
    "auth": { "type": "object", "additionalProperties": true },
    "delivery": { "$ref": "#/$defs/delivery" },
    "retry": { "$ref": "#/$defs/retry" },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemas": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/schema" }
        },
        "eventEnvelopes": { "type": "object", "additionalProperties": true }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "info": {
      "type": "object",
      "required": ["id", "title", "version"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "operation": {
      "type": "object",
      "required": ["id", "title", "interfaceType", "transport", "pattern"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "description": { "type": "string" },
        "interfaceType": {
          "type": "string",
          "enum": [
            "api",
            "event",
            "stream",
            "rpc",
            "batch",
            "callback",
            "device",
            "profile"
          ]
        },
        "transport": { "$ref": "#/$defs/transport" },
        "pattern": {
          "type": "string",
          "enum": [
            "requestResponse",
            "publishSubscribe",
            "stream",
            "callback",
            "batch",
            "attributeAccess"
          ]
        },
        "tags": { "type": "array", "items": { "type": "string" } },
        "auth": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "address": { "$ref": "#/$defs/address" },
        "parameters": { "$ref": "#/$defs/parameterGroups" },
        "bindings": { "type": "object", "additionalProperties": true },
        "delivery": { "$ref": "#/$defs/delivery" },
        "retry": { "$ref": "#/$defs/retry" },
        "request": { "$ref": "#/$defs/message" },
        "response": { "$ref": "#/$defs/message" },
        "responses": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/response" }
        },
        "message": { "$ref": "#/$defs/message" },
        "messages": {
          "type": "array",
          "items": { "$ref": "#/$defs/message" }
        },
        "errors": {
          "type": "array",
          "items": { "$ref": "#/$defs/error" }
        },
        "examples": {
          "type": "array",
          "items": { "$ref": "#/$defs/example" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "transport": { "const": "ble-gatt" } } },
          "then": {
            "properties": {
              "bindings": {
                "type": "object",
                "required": ["ble-gatt"],
                "properties": {
                  "ble-gatt": { "$ref": "#/$defs/bleGattBinding" }
                },
                "additionalProperties": true
              }
            }
          }
        }
      ]
    },
    "transport": {
      "type": "string",
      "enum": [
        "http",
        "mqtt",
        "webhook",
        "websocket",
        "sse",
        "kafka",
        "amqp",
        "grpc",
        "graphql",
        "jsonrpc",
        "file",
        "cloudevents",
        "ble-gatt"
      ]
    },
    "address": {
      "type": "object",
      "required": ["kind", "value"],
      "additionalProperties": true,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "path",
            "topic",
            "url",
            "serviceMethod",
            "method",
            "filePath",
            "queue",
            "exchange",
            "gattService",
            "gattCharacteristic"
          ]
        },
        "value": { "type": "string", "minLength": 1 },
        "method": { "type": "string" }
      }
    },
    "parameterGroups": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "$ref": "#/$defs/field" }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "guarantee": { "type": "string" },
        "ordering": { "type": "string" },
        "duplicateHandling": { "type": "string" },
        "timeoutMs": { "type": "integer", "minimum": 0 },
        "successStatusCodes": {
          "type": "array",
          "items": { "type": "integer" }
        }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "maxAttempts": { "type": "integer", "minimum": 0 },
        "backoff": { "type": "string" },
        "initialDelayMs": { "type": "integer", "minimum": 0 },
        "maxDelayMs": { "type": "integer", "minimum": 0 },
        "retryOn": {
          "type": "array",
          "items": { "type": ["string", "integer"] }
        }
      }
    },
    "message": {
      "type": "object",
      "required": ["schema"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "role": { "type": "string" },
        "direction": { "type": "string" },
        "contentType": { "type": "string" },
        "schema": {
          "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/schema" }]
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "description": { "type": "string" },
        "contentType": { "type": "string" },
        "schema": {
          "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/schema" }]
        }
      }
    },
    "schema": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "object",
            "array",
            "string",
            "number",
            "integer",
            "boolean",
            "datetime",
            "date",
            "uuid",
            "enum",
            "any",
            "binary"
          ]
        },
        "description": { "type": "string" },
        "required": { "type": "boolean" },
        "fields": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/field" }
        },
        "items": {
          "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/schema" }]
        },
        "enum": { "type": "array" },
        "example": true
      }
    },
    "field": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": true,
      "properties": {
        "type": { "type": "string" },
        "required": { "type": "boolean" },
        "description": { "type": "string" },
        "example": true,
        "enum": { "type": "array" },
        "unit": { "type": "string" },
        "format": { "type": "string" },
        "fields": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/field" }
        },
        "items": {
          "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/schema" }]
        }
      }
    },
    "error": {
      "type": "object",
      "required": ["code", "description"],
      "additionalProperties": true,
      "properties": {
        "code": { "type": ["string", "number", "integer"] },
        "status": { "type": ["string", "number", "integer"] },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" },
        "description": { "type": "string" }
      }
    },
    "example": {
      "type": "object",
      "required": ["title", "value"],
      "additionalProperties": true,
      "properties": {
        "title": { "type": "string" },
        "role": { "type": "string" },
        "value": true
      }
    },
    "bleGattBinding": {
      "type": "object",
      "required": ["service", "characteristics"],
      "additionalProperties": true,
      "properties": {
        "role": {
          "type": "string",
          "enum": ["gattServer", "gattClient", "both"]
        },
        "service": { "$ref": "#/$defs/bleGattService" },
        "connection": { "type": "object", "additionalProperties": true },
        "characteristics": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/bleGattCharacteristic" }
        },
        "procedures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": true,
            "properties": {
              "name": { "type": "string" },
              "characteristic": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "bleGattService": {
      "type": "object",
      "required": ["uuid"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "uuid": { "type": "string" },
        "type": { "type": "string", "enum": ["primary", "secondary"] },
        "description": { "type": "string" }
      }
    },
    "bleGattCharacteristic": {
      "type": "object",
      "required": ["uuid", "properties"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "uuid": { "type": "string" },
        "properties": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "broadcast",
              "read",
              "writeWithoutResponse",
              "write",
              "notify",
              "indicate",
              "authenticatedSignedWrites",
              "extendedProperties"
            ]
          }
        },
        "permissions": { "type": "object", "additionalProperties": true },
        "value": { "$ref": "#/$defs/bleGattValue" },
        "descriptors": {
          "type": "array",
          "items": { "$ref": "#/$defs/bleGattDescriptor" }
        },
        "description": { "type": "string" }
      }
    },
    "bleGattDescriptor": {
      "type": "object",
      "required": ["uuid"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "uuid": { "type": "string" },
        "permissions": { "type": "object", "additionalProperties": true },
        "value": { "$ref": "#/$defs/bleGattValue" },
        "description": { "type": "string" }
      }
    },
    "bleGattValue": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "schema": {
          "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/schema" }]
        },
        "contentType": { "type": "string" },
        "format": { "type": "string" },
        "byteOrder": { "type": "string" },
        "unit": { "type": "string" }
      }
    }
  }
}
